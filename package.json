{
  "name": "navy-browser",
  "productName": "NAVY",
  "version": "1.0.3",
  "description": "Le navigateur qui bloque TOUT",
  "main": "src/main.js",
  "author": "lamelow78",
  "license": "MPL-2.0",
  "homepage": "https://github.com/lamelow78/NAVY-BROWSER",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.navy.browser",
    "productName": "NAVY",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "NAVY-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "NAVY.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "artifactName": "NAVY.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    }
  }
}
